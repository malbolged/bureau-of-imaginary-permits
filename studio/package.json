{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../.env -- sanity dev",
    "build": "dotenv -e ../.env -- sanity build",
    "deploy": "dotenv -e ../.env -- sanity deploy",
    "schema:deploy": "dotenv -e ../.env -- sanity schema deploy",
    "seed": "dotenv -e ../.env -- tsx scripts/seed.ts",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/client": "^8.8.0",
    "@sanity/ui": "^4.2.7",
    "@sanity/vision": "^6.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.16.0",
    "styled-components": "^6.5.3",
    "@bureau/workflows": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
